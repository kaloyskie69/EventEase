@model EventEase.ViewModels.Event.EventCreateViewModel
@{
    ViewData["Title"] = "Create Event";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-muted small font-mono">
                    <i class="bi bi-arrow-left me-1"></i> Back to Events
                </a>
                <h3 class="fw-semibold mt-1 mb-0">Create New Event Repository</h3>
            </div>
        </div>

        <form asp-action="Create" method="post" id="eventCreateForm" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <!-- Primary Event Details Card -->
            <div class="card card-modern p-4 mb-4">
                <h5 class="fw-semibold mb-3 pb-2 border-bottom" style="border-color: var(--octo-border) !important;">
                    <i class="bi bi-terminal text-primary me-2"></i> Event Metadata
                </h5>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label small font-mono">Event Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. 2026 Tech Summit & Developer Workshop" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label small font-mono">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide event agenda, topics, or speaker details..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Venue" class="form-label small font-mono">Venue / Location <span class="text-danger">*</span></label>
                        <input asp-for="Venue" class="form-control" placeholder="e.g. Main Auditorium / Room 302, Building A" />
                        <span asp-validation-for="Venue" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label small font-mono">Date <span class="text-danger">*</span></label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Time" class="form-label small font-mono">Time / Schedule <span class="text-danger">*</span></label>
                        <input asp-for="Time" class="form-control" placeholder="e.g. 09:00 AM - 04:00 PM" />
                        <span asp-validation-for="Time" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label small font-mono"></label>
                        <input asp-for="Capacity" type="number" min="1" class="form-control" placeholder="Leave blank for no limit" />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Custom Questions Builder Card -->
            <div class="card card-modern p-4 mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-2 mb-3 border-bottom gap-2" style="border-color: var(--octo-border) !important;">
                    <div>
                        <h5 class="fw-semibold mb-0">
                            <i class="bi bi-sliders text-secondary me-2"></i> Custom Dynamic Questions
                        </h5>
                        <p class="text-muted small mb-0 font-mono">Embedded schema fields captured on attendee RSVP submission.</p>
                    </div>
                    <button type="button" class="btn btn-outline-custom btn-sm" id="btnAddCustomField">
                        <i class="bi bi-plus-lg me-1"></i> Add Question Field
                    </button>
                </div>

                <!-- Quick Presets -->
                <div class="mb-3">
                    <span class="small font-mono text-muted me-2">Presets:</span>
                    <div class="btn-group btn-group-sm flex-wrap gap-1 mt-1">
                        <button type="button" class="btn btn-outline-custom btn-sm btn-preset-question font-mono" 
                                data-label="Dietary Restriction" data-type="Dropdown" data-options="None,Vegetarian,Vegan,Halal,Gluten-Free" data-required="true">
                            + Dietary Restriction
                        </button>
                        <button type="button" class="btn btn-outline-custom btn-sm btn-preset-question font-mono" 
                                data-label="Organization / Company" data-type="Text" data-options="" data-required="false">
                            + Organization
                        </button>
                        <button type="button" class="btn btn-outline-custom btn-sm btn-preset-question font-mono" 
                                data-label="Student ID" data-type="Text" data-options="" data-required="true">
                            + Student ID
                        </button>
                        <button type="button" class="btn btn-outline-custom btn-sm btn-preset-question font-mono" 
                                data-label="Equipment Needed" data-type="Dropdown" data-options="None,Laptop Charger,Monitor,Extension Cord" data-required="false">
                            + Equipment
                        </button>
                    </div>
                </div>

                <div id="customFieldsContainer">
                    <!-- Populated dynamically via ~/js/event-form.js -->
                </div>

                <div id="noCustomFieldsNotice" class="text-center py-4 text-muted rounded" style="background-color: var(--octo-bg); border: 1px dashed var(--octo-border);">
                    <i class="bi bi-input-cursor-text fs-4 d-block mb-1 text-muted"></i>
                    <p class="mb-0 small font-mono">No custom questions added yet. Use the presets above or add custom fields.</p>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="d-flex justify-content-end gap-2 mb-5">
                <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save & Publish Event
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/event-form.js" asp-append-version="true"></script>
}
