@* Octo Code Toast Notifications — Displayed as Bootstrap Toasts with dark theme *@
<div id="globalToastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true"
             style="background: var(--octo-surface); border: 1px solid rgba(63, 185, 80, 0.4) !important; color: var(--octo-text-primary);">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill" style="color: var(--octo-success);"></i>
                    <div>
                        <strong class="font-mono" style="color: var(--octo-success);">success:</strong> 
                        <span class="small">@TempData["SuccessMessage"]</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true"
             style="background: var(--octo-surface); border: 1px solid rgba(248, 81, 73, 0.4) !important; color: var(--octo-text-primary);">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill" style="color: var(--octo-error);"></i>
                    <div>
                        <strong class="font-mono" style="color: var(--octo-error);">error:</strong>
                        <span class="small">@TempData["ErrorMessage"]</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>
