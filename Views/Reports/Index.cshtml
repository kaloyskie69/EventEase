@model EventEase.ViewModels.Reports.EventReportViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-semibold mb-1">Reports & Analytics</h3>
        <p class="text-muted mb-0 font-mono small">Event turnout performance, RSVP conversion, and historical trends.</p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-custom" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- 4 Key Reporting Cards -->
<div class="row g-2 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <div class="stat-value">@Model.TotalEvents</div>
                <div class="stat-label">Events Hosted</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon info">
                <i class="bi bi-envelope-paper"></i>
            </div>
            <div>
                <div class="stat-value" style="color: var(--octo-link);">@Model.TotalRSVPs</div>
                <div class="stat-label">Total RSVPs</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <div class="stat-value" style="color: var(--octo-success);">@Model.TotalCheckedIn</div>
                <div class="stat-label">Actual Attendees</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="bi bi-pie-chart-fill"></i>
            </div>
            <div>
                <div class="stat-value" style="color: var(--octo-success);">@Model.OverallAttendanceRate%</div>
                <div class="stat-label">Turnout Rate</div>
            </div>
        </div>
    </div>
</div>

<!-- Visual Charts Section -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card card-modern h-100">
            <h5 class="fw-semibold mb-1">Monthly Growth & Turnout Trends</h5>
            <small class="text-muted font-mono mb-3 d-block">Events organized vs actual checked-in headcount</small>
            <div style="position: relative; height: 280px;">
                <canvas id="monthlyEventsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-modern h-100">
            <h5 class="fw-semibold mb-1">Overall RSVP Distribution</h5>
            <small class="text-muted font-mono mb-3 d-block">Breakdown: Going / Maybe / Not Going</small>
            <div style="position: relative; height: 220px;">
                <canvas id="rsvpDistributionChart"></canvas>
            </div>
            <div class="d-flex justify-content-around text-center pt-3 border-top mt-2" style="border-color: var(--octo-border) !important;">
                <div>
                    <span class="badge badge-going d-block mb-1 font-mono">going</span>
                    <strong class="font-mono fs-6" style="color: var(--octo-success);">@Model.RsvpDistribution.GoingCount</strong>
                </div>
                <div>
                    <span class="badge badge-maybe d-block mb-1 font-mono">maybe</span>
                    <strong class="font-mono fs-6" style="color: var(--octo-warning);">@Model.RsvpDistribution.MaybeCount</strong>
                </div>
                <div>
                    <span class="badge badge-notgoing d-block mb-1 font-mono">not_going</span>
                    <strong class="font-mono fs-6" style="color: var(--octo-error);">@Model.RsvpDistribution.NotGoingCount</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Performance Summary Table of All Events -->
<div class="card card-modern p-4 mb-5">
    <h5 class="fw-semibold mb-3">Event Performance Summary</h5>
    @if (Model.EventSummaries.Any())
    {
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Status</th>
                        <th>RSVPs</th>
                        <th>Going</th>
                        <th>Checked In</th>
                        <th>Turnout</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.EventSummaries)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="fw-semibold" style="color: var(--octo-link);">@ev.Title</a>
                            </td>
                            <td class="font-mono small">@ev.Date.ToString("yyyy-MM-dd")</td>
                            <td class="text-muted small">@ev.Venue</td>
                            <td>
                                @if (ev.Status == "Upcoming")
                                {
                                    <span class="badge badge-going font-mono">upcoming</span>
                                }
                                else if (ev.Status == "Completed")
                                {
                                    <span class="badge badge-neutral font-mono">completed</span>
                                }
                                else
                                {
                                    <span class="badge badge-notgoing font-mono">cancelled</span>
                                }
                            </td>
                            <td class="font-mono">@ev.TotalRSVPs</td>
                            <td class="font-mono" style="color: var(--octo-success);">@ev.GoingCount</td>
                            <td class="font-mono" style="color: var(--octo-link);">@ev.CheckedInCount</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 4px; width: 60px;">
                                        <div class="progress-bar" role="progressbar" style="width: @ev.AttendancePercentage%" aria-valuenow="@ev.AttendancePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="small font-mono fw-semibold">@ev.AttendancePercentage%</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Attendance" asp-action="CheckIn" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-custom" title="Check-In Roster">
                                        <i class="bi bi-qr-code-scan"></i>
                                    </a>
                                    <a asp-controller="Events" asp-action="ExportCsv" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-custom" title="Export CSV">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state py-4">
            <i class="bi bi-graph-up empty-state-icon"></i>
            <h5 class="fw-semibold">No data available</h5>
            <p class="text-muted small font-mono">Host your first event to see analytics and performance metrics.</p>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends));
            var rsvpData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RsvpDistribution));
            initDashboardCharts(monthlyData, rsvpData, null);
        });
    </script>
}
