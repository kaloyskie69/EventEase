@model EventEase.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Organizer Login";
}

<div class="container-fluid px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 col-xl-4">
            <div class="card card-modern p-4">
                <div class="text-center mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 56px; height: 56px; background: rgba(47, 129, 247, 0.15); border: 1px solid rgba(47, 129, 247, 0.3); color: var(--octo-primary);">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                    </span>
                    <h3 class="fw-semibold">Sign In</h3>
                    <p class="text-muted small font-mono">Organizer access to events, check-in, and analytics</p>
                </div>

                <div class="alert alert-info small mb-4 font-mono">
                    <div class="fw-semibold mb-1"><i class="bi bi-key-fill me-1"></i> Demo Credentials:</div>
                    <div>Email: <code>organizer@eventease.com</code></div>
                    <div>Password: <code>Password123!</code></div>
                </div>

                <form asp-action="Login" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small font-mono">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small font-mono">Password</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small font-mono text-muted">Remember me</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" style="height: 40px;">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-muted" style="border-color: var(--octo-border) !important;">
                    Don't have an account?
                    <a asp-action="Register" class="fw-semibold ms-1" style="color: var(--octo-link);">Register here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
