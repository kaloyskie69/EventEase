@model IEnumerable<EventEase.Models.Event>
@{
    ViewData["Title"] = "Event RSVP & Check-In";
}

<!-- Hero Section -->
<section class="hero-gradient">
    <div class="container-fluid px-lg-5 py-4">
        <div class="row align-items-center gy-5">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold text-white mb-3">
                    Streamlined Event RSVPs. <br/>
                    <span style="color: var(--octo-link);">Live Check-In</span> Roster.
                </h1>
                <p class="lead text-muted mb-4" style="max-width: 640px; font-size: 16px;">
                    Share one link and let guests RSVP in seconds, no signup needed. Ask your own questions and check people in on the day.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i> Create Event
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-custom">
                        <i class="bi bi-box-arrow-in-right"></i> Organizer Portal
                    </a>
                </div>

                <div class="pt-3 border-top d-flex flex-wrap gap-4 text-muted small" style="border-color: var(--octo-border) !important;">
                    <div><i class="bi bi-check2 text-success me-1"></i> No account needed to RSVP</div>
                    <div><i class="bi bi-check2 text-success me-1"></i> Custom questions</div>
                    <div><i class="bi bi-check2 text-success me-1"></i> One-tap check-in</div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card card-modern p-3">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-2 border-bottom" style="border-color: var(--octo-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge badge-going"><i class="bi bi-broadcast"></i></span>
                            <span class="fw-semibold">Today's guest list</span>
                        </div>
                        <span class="badge badge-going">Live</span>
                    </div>

                    <!-- Mini sample table -->
                    <div class="list-group list-group-flush mb-3">
                        <div class="list-group-item d-flex align-items-center justify-content-between px-2 py-2">
                            <div>
                                <div class="fw-semibold" style="color: var(--octo-link);">Elena Rostova</div>
                                <div class="text-muted small">Dietary: Salmon</div>
                            </div>
                            <span class="badge badge-checkedin">Checked in</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center justify-content-between px-2 py-2">
                            <div>
                                <div class="fw-semibold" style="color: var(--octo-link);">Marcus Chen</div>
                                <div class="text-muted small">+1 guest</div>
                            </div>
                            <span class="badge badge-checkedin">Checked in</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center justify-content-between px-2 py-2">
                            <div>
                                <div class="fw-semibold" style="color: var(--octo-link);">Chloe Bennett</div>
                                <div class="text-muted small">RSVP'd</div>
                            </div>
                            <span class="badge badge-maybe">Waiting</span>
                        </div>
                    </div>

                    <div class="p-2 rounded d-flex justify-content-center align-items-center" style="background-color: var(--octo-bg); border: 1px solid var(--octo-border);">
                        <span class="fw-semibold" style="color: var(--octo-success);">2 of 3 guests arrived</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Demo Credentials Alert Box -->
<section class="container-fluid px-lg-5 py-3">
    <div class="alert alert-info d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-info-circle-fill fs-5" style="color: var(--octo-primary);"></i>
            <div>
                <strong>Quick Demo Access:</strong> Log in with the pre-seeded Organizer account:
                <code class="ms-1">organizer@eventease.com</code> /
                <code class="ms-1">Password123!</code>
            </div>
        </div>
        <a asp-controller="Account" asp-action="Login" class="btn btn-blue btn-sm">
            Sign In <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>

<!-- Upcoming Public Events Showcase -->
<section class="container-fluid px-lg-5 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h2 class="h3 fw-semibold mb-1">Public Events Directory</h2>
            <p class="text-muted mb-0">Upcoming events you can RSVP to</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-3">
            @foreach (var ev in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <!-- Repository Card Style -->
                    <div class="card card-modern h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <a asp-controller="RSVP" asp-action="EventDetails" asp-route-id="@ev.Id" class="fw-semibold fs-6" style="color: var(--octo-link);">
                                <i class="bi bi-bookmark-fill me-1 small"></i> @ev.Title
                            </a>
                            <span class="badge badge-going">Public</span>
                        </div>

                        <p class="text-muted small mb-3 flex-grow-1">
                            @(ev.Description?.Length > 110 ? ev.Description.Substring(0, 107) + "..." : ev.Description ?? "No description provided.")
                        </p>

                        <!-- Card Footer: Metadata -->
                        <div class="pt-2 border-top d-flex align-items-center justify-content-between text-muted small" style="border-color: var(--octo-border) !important;">
                            <div class="d-flex align-items-center gap-3">
                                <span>
                                    <span class="d-inline-block rounded-circle me-1" style="width: 10px; height: 10px; background-color: var(--octo-secondary);"></span>
                                    @ev.Date.ToString("MMM dd, yyyy")
                                </span>
                                <span>
                                    <i class="bi bi-geo-alt"></i> @ev.Venue
                                </span>
                            </div>
                            <a asp-controller="RSVP" asp-action="EventDetails" asp-route-id="@ev.Id" class="btn btn-outline-custom btn-sm">
                                RSVP
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-folder-x empty-state-icon"></i>
            <h5 class="fw-semibold">No public events active</h5>
            <p class="text-muted small">Create an event from the organizer portal to generate a public link.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">
                Create Event
            </a>
        </div>
    }
</section>

<!-- Features Grid -->
<section class="container-fluid px-lg-5 py-4 border-top" style="border-color: var(--octo-border) !important;">
    <div class="mb-4">
        <h2 class="h3 fw-semibold mb-1">Everything you need to run your event</h2>
        <p class="text-muted mb-0">From sharing your invite to checking guests in at the door.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card card-modern h-100 d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge badge-primary"><i class="bi bi-link-45deg"></i></span>
                    <h5 class="mb-0 fw-semibold">Share One Simple Link</h5>
                </div>
                <p class="text-muted small mb-0 flex-grow-1">
                    Guests RSVP from a public link. No account or signup needed.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-modern h-100 d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge badge-warning"><i class="bi bi-sliders"></i></span>
                    <h5 class="mb-0 fw-semibold">Ask Your Own Questions</h5>
                </div>
                <p class="text-muted small mb-0 flex-grow-1">
                    Add custom questions to your RSVP form, like meal choice, plus-ones, or accessibility needs.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-modern h-100 d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge badge-going"><i class="bi bi-qr-code-scan"></i></span>
                    <h5 class="mb-0 fw-semibold">Check Guests In Fast</h5>
                </div>
                <p class="text-muted small mb-0 flex-grow-1">
                    Search your guest list and check people in with one tap. Turnout updates instantly.
                </p>
            </div>
        </div>
    </div>
</section>
